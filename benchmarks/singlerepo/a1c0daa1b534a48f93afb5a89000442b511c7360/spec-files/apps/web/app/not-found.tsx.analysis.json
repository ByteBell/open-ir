        "parentUnitId": null,
        "startLine": 8,
        "endLine": 19,
        "isBehavioral": true,
        "source": "export const generateMetadata = async () => {\n  const metadata = await _generateMetadata(\n    (t) => t(\"404_page_not_found\"),\n    (t) => t(\"404_page_not_found\")\n  );\n  return {\n    ...metadata,\n    robots: {\n      index: false,\n      follow: false,\n    },\n  };"
      },
      {
        "unitId": "apps/web/app/not-found.tsx__ServerPage#function:ServerPage",
        "unitKind": "function",
        "name": "ServerPage",
        "qualifiedName": "ServerPage",
        "parentUnitId": null,
        "startLine": 21,
        "endLine": 31,
        "isBehavioral": true,
        "source": "\nconst ServerPage = async () => {\n  const h = await headers();\n  const nonce = h.get(\"x-nonce\") ?? undefined;\n  const host = h.get(\"x-forwarded-host\") ?? \"\";\n\n  return (\n    <PageWrapper requiresLicense={false} nonce={nonce}>\n      <NotFound host={host} />\n    </PageWrapper>\n  );"
      }
    ]
