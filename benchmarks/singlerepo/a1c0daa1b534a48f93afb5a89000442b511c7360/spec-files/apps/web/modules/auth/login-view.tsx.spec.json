        "startLine": 49,
        "endLine": 56,
        "isBehavioral": true,
        "source": "export default function Login({\n  csrfToken,\n  isGoogleLoginEnabled,\n  isSAMLLoginEnabled,\n  samlTenantID,\n  samlProductID,\n  totpEmail,\n}: // eslint-disable-next-line @typescript-eslint/ban-types"
      },
      {
        "unitId": "apps/web/modules/auth/login-view.tsx__Login.onSubmit_5#function:Login.onSubmit",
        "unitKind": "function",
        "name": "onSubmit",
        "qualifiedName": "Login.onSubmit",
        "parentUnitId": "apps/web/modules/auth/login-view.tsx__Login_4#function:Login",
        "startLine": 150,
        "endLine": 168,
        "isBehavioral": true,
        "source": "  const onSubmit = async (values: LoginValues) => {\n    setErrorMessage(null);\n    telemetry.event(telemetryEventTypes.login, collectPageParameters());\n    const res = await signIn<\"credentials\">(\"credentials\", {\n      ...values,\n      callbackUrl,\n      redirect: false,\n    });\n    if (!res) setErrorMessage(errorMessages[ErrorCode.InternalServerError]);\n    // we're logged in! let's do a hard refresh to the desired url\n    else if (!res.error) {\n      setLastUsed(\"credentials\");\n      router.push(callbackUrl);\n    } else if (res.error === ErrorCode.SecondFactorRequired) setTwoFactorRequired(true);\n    else if (res.error === ErrorCode.IncorrectBackupCode) setErrorMessage(t(\"incorrect_backup_code\"));\n    else if (res.error === ErrorCode.MissingBackupCodes) setErrorMessage(t(\"missing_backup_codes\"));\n    // fallback if error not found\n    else setErrorMessage(errorMessages[res.error] || t(\"something_went_wrong\"));\n  };"
      },
      {
        "unitId": "apps/web/modules/auth/login-view.tsx__Login.refactorMeWithoutEffect_6#function:Login.refactorMeWithoutEffect",
        "unitKind": "function",
        "name": "refactorMeWithoutEffect",
        "qualifiedName": "Login.refactorMeWithoutEffect",
        "parentUnitId": "apps/web/modules/auth/login-view.tsx__Login_4#function:Login",
        "startLine": 173,
        "endLine": 177,
        "isBehavioral": true,
        "source": "    function refactorMeWithoutEffect() {\n      if (error) {\n        setErrorMessage(error.message);\n      }\n    },"
      }
    ]
