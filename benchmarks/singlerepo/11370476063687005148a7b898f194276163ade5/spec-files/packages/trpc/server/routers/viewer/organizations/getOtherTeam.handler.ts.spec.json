        "parentUnitId": null,
        "startLine": 23,
        "endLine": 54,
        "isBehavioral": true,
        "source": "export const getOtherTeamHandler = async ({ input }: GetOptions) => {\n  // No need to validate if user is admin of org as we already do that on authedOrgAdminProcedure\n  const team = await prisma.team.findUnique({\n    where: {\n      id: input.teamId,\n    },\n    select: {\n      id: true,\n      name: true,\n      slug: true,\n      logoUrl: true,\n      bio: true,\n      metadata: true,\n      isPrivate: true,\n      parent: {\n        select: {\n          id: true,\n          slug: true,\n        },\n      },\n    },\n  });\n\n  if (!team) {\n    throw new TRPCError({ code: \"NOT_FOUND\", message: \"Team not found.\" });\n  }\n\n  return {\n    ...team,\n    safeBio: markdownToSafeHTML(team.bio),\n  };\n};"
      },
