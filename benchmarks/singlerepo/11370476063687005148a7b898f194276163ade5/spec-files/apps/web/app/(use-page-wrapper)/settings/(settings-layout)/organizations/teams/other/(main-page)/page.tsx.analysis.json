        "source": "export const generateMetadata = async () =>\n  await _generateMetadata(\n    (t) => t(\"org_admin_other_teams\"),\n    (t) => t(\"org_admin_other_teams_description\"),\n    undefined,\n    undefined,\n    \"/settings/organizations/teams/other\"\n  );"
