        "isBehavioral": true,
        "source": "export const generateMetadata = async () =>\n  await _generateMetadata(\n    (t) => t(\"roles_and_permissions\"),\n    (t) => t(\"roles_and_permissions_description\"),\n    undefined,\n    undefined,\n    \"/settings/organizations/roles\"\n  );"
