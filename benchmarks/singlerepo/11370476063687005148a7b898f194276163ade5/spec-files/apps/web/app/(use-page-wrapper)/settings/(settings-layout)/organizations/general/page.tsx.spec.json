        "isBehavioral": true,
        "source": "export const generateMetadata = async () =>\n  await _generateMetadata(\n    (t) => t(\"general\"),\n    (t) => t(\"general_description\"),\n    undefined,\n    undefined,\n    \"/settings/organizations/general\"\n  );"
