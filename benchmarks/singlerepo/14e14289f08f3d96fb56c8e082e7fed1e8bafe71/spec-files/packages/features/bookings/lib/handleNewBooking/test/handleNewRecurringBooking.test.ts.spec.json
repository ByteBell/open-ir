          "testId": "creates-successful-recurring-bookings",
          "scenario": "A recurring booking request contains multiple available slots for a user event type.",
          "given": [
            "const numOfSlotsToBeBooked = 4;",
            "const bookingDataArray = Array(numOfSlotsToBeBooked).fill(mockBookingData).map((mockBookingData, index) => ({ ...mockBookingData, start: getPlusDayDate(mockBookingData.start, index).toISOString(), end: getPlusDayDate(mockBookingData.end, index).toISOString() }));"
          ],
          "when": "const createdBookings = await handleNewRecurringBooking({ bookingData: bookingDataArray, userId: -1 });",
          "then": "expect(createdBookings.length).toBe(numOfSlotsToBeBooked);",
          "targets": [],
          "oracleKind": "integration-trace",
          "rationale": "Guards creation of every requested slot and associated booking side effects."
        },
        {
          "testId": "rejects-recurring-booking-when-slot-is-booked",
          "scenario": "The second requested recurring slot is already occupied by an accepted booking.",
          "given": [
            "bookings: [{ uid: \"booking-1-uid\", eventTypeId: 1, userId: organizer.id, status: BookingStatus.ACCEPTED, startTime: `${plus2DateString}T04:00:00.000Z`, endTime: `${plus2DateString}T04:30:00.000Z` }]"
          ],
          "when": "await handleNewRecurringBooking({ bookingData: bookingDataArray, userId: -1 })",
          "then": "await expect(async () => await handleNewRecurringBooking({ bookingData: bookingDataArray, userId: -1 })).rejects.toThrow(ErrorCode.NoAvailableUsersFound);",
          "targets": [],
          "oracleKind": "integration-trace",
          "rationale": "Ensures recurring creation fails when a requested slot has no available host."
        },
        {
          "testId": "rejects-recurring-round-robin-booking-when-fixed-host-unavailable",
          "scenario": "A round-robin recurring booking requires a fixed host who is unavailable for a later slot.",
          "given": [
            "schedulingType: SchedulingType.ROUND_ROBIN",
            "bookings: [{ userId: 102, eventTypeId: 1, status: \"ACCEPTED\", startTime: `${plus2DateString}T04:00:00.000Z`, endTime: `${plus2DateString}T04:30:00.000Z` }]"
          ],
          "when": "handleNewRecurringBooking({ bookingData: bookingDataArray, userId: -1 })",
          "then": "await expect(() => handleNewRecurringBooking({ bookingData: bookingDataArray, userId: -1 })).rejects.toThrow(ErrorCode.NoAvailableUsersFound);",
          "targets": [],
