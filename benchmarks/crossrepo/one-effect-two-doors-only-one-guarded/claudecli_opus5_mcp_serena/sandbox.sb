(version 1)
(allow default)

;; ---- benchmark tree: blind everything, then re-open only what this arm needs ----
;; Later rules win, so this denies golden.json, every other arm's ranked.json /
;; result.json, and the case-construction scripts.
(deny file-read* (subpath "~/programs/benchmarks/react-ecosystem"))
(allow file-read*
  (subpath "~/programs/benchmarks/react-ecosystem/redux")
  (subpath "~/programs/benchmarks/react-ecosystem/redux-toolkit")
  (subpath "~/programs/benchmarks/react-ecosystem/react-redux")
  (subpath "~/programs/benchmarks/react-ecosystem/reselect")
  (subpath "~/programs/benchmarks/react-ecosystem/redux-thunk")
  (subpath "~/programs/benchmarks/react-ecosystem/react")
  (subpath "~/programs/benchmarks/react-ecosystem/jotai")
  (subpath "~/programs/benchmarks/react-ecosystem/zustand")
  (subpath "~/programs/benchmarks/react-ecosystem/db")
  (subpath "~/programs/benchmarks/react-ecosystem/xyflow")
  (subpath "~/programs/benchmarks/react-ecosystem/query")
  (subpath "~/programs/benchmarks/react-ecosystem/table")
  (subpath "~/programs/benchmarks/react-ecosystem/tldraw")
  (subpath "~/programs/benchmarks/react-ecosystem/redux-devtools")
  (subpath "~/programs/benchmarks/react-ecosystem/router")
  (subpath "~/programs/benchmarks/react-ecosystem/cross-repo/_indexes/serena_mcp"))
(deny file-write* (subpath "~/programs/benchmarks/react-ecosystem"))

;; the language server writes its per-project cache under <repo>/.serena
(allow file-write*
  (subpath "~/programs/benchmarks/react-ecosystem/redux/.serena")
  (subpath "~/programs/benchmarks/react-ecosystem/redux-toolkit/.serena")
  (subpath "~/programs/benchmarks/react-ecosystem/react-redux/.serena")
  (subpath "~/programs/benchmarks/react-ecosystem/reselect/.serena")
  (subpath "~/programs/benchmarks/react-ecosystem/redux-thunk/.serena")
  (subpath "~/programs/benchmarks/react-ecosystem/react/.serena")
  (subpath "~/programs/benchmarks/react-ecosystem/jotai/.serena")
  (subpath "~/programs/benchmarks/react-ecosystem/zustand/.serena")
  (subpath "~/programs/benchmarks/react-ecosystem/db/.serena")
  (subpath "~/programs/benchmarks/react-ecosystem/xyflow/.serena")
  (subpath "~/programs/benchmarks/react-ecosystem/query/.serena")
  (subpath "~/programs/benchmarks/react-ecosystem/table/.serena")
  (subpath "~/programs/benchmarks/react-ecosystem/tldraw/.serena")
  (subpath "~/programs/benchmarks/react-ecosystem/redux-devtools/.serena")
  (subpath "~/programs/benchmarks/react-ecosystem/router/.serena"))

;; ---- no session transcript is readable: not an earlier run's, not this one's ----
(deny file-read* (subpath "/Users/sauravverma/.claude/projects"))
(deny file-read* (subpath "/Users/sauravverma/.claude/history.jsonl"))
