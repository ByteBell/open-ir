{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": "deny",
    "edit": "deny",
    "webfetch": "deny"
  },
  "mcp": {
    "plumbline": {
      "type": "remote",
      "url": "http://localhost/mcp?access_token=${PLUMBLINE_MCP_TOKEN}",
      "enabled": true
    }
  },
  "agent": {
    "plumbline-arm": {
      "mode": "primary",
      "model": "openrouter/tencent/hy4-preview",
      "description": "plumbline-MCP-only retrieval arm",
      "tools": {
        "bash": false,
        "edit": false,
        "write": false,
        "read": false,
        "patch": false,
        "grep": false,
        "glob": false,
        "list": false,
        "todowrite": false,
        "todoread": false,
        "webfetch": false,
        "task": false,
        "invalid": false,
        "skill": false,
        "plumbline*": true
      }
    }
  }
}
