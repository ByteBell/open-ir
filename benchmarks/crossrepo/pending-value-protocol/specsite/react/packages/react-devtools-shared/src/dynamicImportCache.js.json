        "startLine": 30,
        "endLine": 49,
        "isBehavioral": true,
        "source": "function readRecord<T>(record: Thenable<T>): T | null {\n  if (typeof React.use === 'function') {\n    try {\n      // eslint-disable-next-line react-hooks-published/rules-of-hooks\n      return React.use(record);\n    } catch (x) {\n      if (x === null) {\n        return null;\n      }\n      throw x;\n    }\n  }\n  if (record.status === 'fulfilled') {\n    return record.value;\n  } else if (record.status === 'rejected') {\n    return null;\n  } else {\n    throw record;\n  }\n}",
