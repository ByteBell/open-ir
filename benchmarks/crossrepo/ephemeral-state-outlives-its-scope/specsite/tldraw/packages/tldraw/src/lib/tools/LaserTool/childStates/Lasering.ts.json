    "module": {
      "purpose": "Implements the active laser-drawing state, recording pointer positions into a scribble session and finalizing that session on completion or cancellation.",
      "summary": "This state node coordinates an ongoing laser stroke. Entry initializes session identifiers and records the first point, pointer movement appends subsequent points, ticks keep the session extended, and termination completes the scribble before transitioning the parent state back to idle.",
      "businessContext": "Supports transient laser-pointer annotations in the collaborative canvas. If it fails, laser strokes may not appear, remain incomplete, or leave the tool stuck outside its idle state.",
      "classes": ["Lasering (~L3-40): State node representing an active laser scribble interaction"],
      "functions": [
        "onEnter (~L10-14): Initializes identifiers and records the stroke's first point",
        "onPointerMove (~L16-18): Appends the current pointer location to the scribble",
        "pushPointToScribble (~L20-23): Reads the page point and adds it to session",
        "onTick (~L25-27): Extends the active scribble session during interaction",
        "onPointerUp (~L29-31): Completes the active laser interaction on pointer release",
