(version 1)
(allow default)

;; ---- benchmark tree: blind everything, then re-open only what this arm needs ----
;; Later rules win, so this denies golden.json, every other arm's ranked.json /
;; result.json, and the case-construction scripts.
(deny file-read* (subpath "/Users/sauravverma/programs/benchmarks/react-ecosystem"))
(allow file-read*
  (subpath "/Users/sauravverma/programs/benchmarks/react-ecosystem/redux")
  (subpath "/Users/sauravverma/programs/benchmarks/react-ecosystem/redux-toolkit")
  (subpath "/Users/sauravverma/programs/benchmarks/react-ecosystem/react-redux")
  (subpath "/Users/sauravverma/programs/benchmarks/react-ecosystem/reselect")
  (subpath "/Users/sauravverma/programs/benchmarks/react-ecosystem/redux-thunk")
  (subpath "/Users/sauravverma/programs/benchmarks/react-ecosystem/react")
  (subpath "/Users/sauravverma/programs/benchmarks/react-ecosystem/jotai")
  (subpath "/Users/sauravverma/programs/benchmarks/react-ecosystem/zustand")
  (subpath "/Users/sauravverma/programs/benchmarks/react-ecosystem/db")
  (subpath "/Users/sauravverma/programs/benchmarks/react-ecosystem/xyflow")
  (subpath "/Users/sauravverma/programs/benchmarks/react-ecosystem/query")
  (subpath "/Users/sauravverma/programs/benchmarks/react-ecosystem/table")
  (subpath "/Users/sauravverma/programs/benchmarks/react-ecosystem/tldraw")
  (subpath "/Users/sauravverma/programs/benchmarks/react-ecosystem/redux-devtools")
  (subpath "/Users/sauravverma/programs/benchmarks/react-ecosystem/router")
  (subpath "/Users/sauravverma/programs/benchmarks/react-ecosystem/cross-repo/_indexes/turbovec")
  (subpath "/Users/sauravverma/programs/benchmarks/react-ecosystem/cross-repo/_indexes/turbovec_mcp"))
(deny file-write* (subpath "/Users/sauravverma/programs/benchmarks/react-ecosystem"))

;; ---- no session transcript is readable: not an earlier run's, not this one's ----
(deny file-read* (subpath "/Users/sauravverma/.claude/projects"))
(deny file-read* (subpath "/Users/sauravverma/.claude/history.jsonl"))
