(version 1)
(allow default)

;; ---- benchmark tree: blind everything, then re-open only the 14 pinned repos ----
;; Later rules win, so this denies golden.json, DONOTREADTHISFOLDER/, every other
;; arm's ranked.json/result.json, and the case-construction scripts, while leaving
;; the fourteen checkouts (untracked distractor files included) fully readable.
(deny file-read* (subpath "~/programs/benchmarks/react-ecosystem"))
(allow file-read*
  (subpath "~/programs/benchmarks/react-ecosystem/redux")
  (subpath "~/programs/benchmarks/react-ecosystem/redux-toolkit")
  (subpath "~/programs/benchmarks/react-ecosystem/react-redux")
  (subpath "~/programs/benchmarks/react-ecosystem/reselect")
  (subpath "~/programs/benchmarks/react-ecosystem/redux-thunk")
  (subpath "~/programs/benchmarks/react-ecosystem/react")
  (subpath "~/programs/benchmarks/react-ecosystem/jotai")
  (subpath "~/programs/benchmarks/react-ecosystem/zustand")
  (subpath "~/programs/benchmarks/react-ecosystem/db")
  (subpath "~/programs/benchmarks/react-ecosystem/xyflow")
  (subpath "~/programs/benchmarks/react-ecosystem/query")
  (subpath "~/programs/benchmarks/react-ecosystem/table")
  (subpath "~/programs/benchmarks/react-ecosystem/tldraw")
  (subpath "~/programs/benchmarks/react-ecosystem/redux-devtools"))
(deny file-write* (subpath "~/programs/benchmarks/react-ecosystem"))

;; ---- no session transcript is readable: not an earlier run's, not this one's ----
(deny file-read* (subpath "/Users/sauravverma/.claude/projects"))
(deny file-read* (subpath "/Users/sauravverma/.claude/history.jsonl"))
